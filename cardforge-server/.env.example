# CardForge server settings. Copy to .env (never commit .env). Keys stay here or in the
# environment; logs and /health only say whether a key is present.

# OpenRouter key of the company (render GPT Image 2.5, judges). Without it: plans only.
OPENROUTER_API_KEY=

# Address the clients and gate pages use (behind a TLS proxy: https://…; enables Secure cookies).
CARDFORGE_PUBLIC_URL=http://127.0.0.1:8006
# Extra allowed Origin values for /mcp and the pages (comma-separated); the public URL is allowed.
CARDFORGE_ALLOWED_ORIGINS=
CARDFORGE_SERVER_HOST=127.0.0.1
CARDFORGE_SERVER_PORT=8006

# Runs at once; the rest wait in the queue. Paid runs additionally take the core paid lock.
WORKER_CONCURRENCY=2
# embedded = dispatcher inside the server process; external = `python -m server.worker`.
CARDFORGE_SERVER_WORKER=embedded

# Who may take G3 actions (select_variant, regenerate_cards, export_run): mcp,web (like the
# local plugin) or web (browser only, portal plan §4).
CARDFORGE_G3_CHANNELS=mcp,web
CARDFORGE_SESSION_HOURS=12

# Monthly OpenRouter limit per user, USD (user 2026-11-10: $50, changed by the admin; per-user
# overrides: `python -m server.budget_users set --owner <name> --usd <n>` or POST /admin/limits).
USER_MONTH_LIMIT_USD=50
# Runs are kept this many days after delivery, then archived to runs/_archive/ (server.retention).
RUN_RETENTION_DAYS=30
# How often the dispatcher runs the retention sweep (hours; 0 = only by hand).
RETENTION_EVERY_H=6

# Offline demo / e2e only: start_run uses the fake planner and FakeBackend. Never in production.
CARDFORGE_SERVER_DEMO=0

# Kill switch: also `runs/STOP` (POST /admin/stop). CARDFORGE_STOP=1 stops every run.
# CARDFORGE_STOP=0
