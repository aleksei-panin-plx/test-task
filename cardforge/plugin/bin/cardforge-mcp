#!/bin/sh
# Starts the CardForge MCP server (stdio) from the installed core.
# Core folder: $CARDFORGE_HOME, else ~/.cardforge/current, else the project that holds this plugin.
here=$(cd "$(dirname "$0")/.." && pwd)
for home in "$CARDFORGE_HOME" "$HOME/.cardforge/current" "$(dirname "$here")"; do
  if [ -n "$home" ] && [ -x "$home/.venv/bin/cardforge" ]; then
    cd "$home" || exit 1
    exec "$home/.venv/bin/cardforge" mcp --root "$home"
  fi
done
echo "cardforge-mcp: CardForge core not found (set CARDFORGE_HOME or run the installer)" >&2
exit 1
