# CardForge repository (dist/): code, configs, knowledge, docs and the data archive in parts.
# The data archive is committed as cardforge/data-parts/*.part-NN (user 2026-11-10); weights are
# downloaded by the installer (see README.md «Данные и что не входит в репозиторий»).

# unpacked data and the whole archive (its parts in data-parts/ are committed), folder 1's assets/
assets/
dataset/
data/
**/knowledge/frames/*.png
*.tar.gz
*.tgz
*.zip

# weights (fetched by `cardforge fetch-assets` / the installer from models/*/source.json)
models/**
!models/*/
!models/*/source.json
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt
*.npz

# runs and local state
runs/

# private human labels
*.private*
labels.private/

# keys: env only
.env
.env.*
!.env.example

# environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
